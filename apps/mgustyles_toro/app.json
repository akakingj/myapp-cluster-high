{
  "id": "mgustyles_toro",
  "title": "mgu-styles2",
  "vendor": "MGU-Styles",
  "version": "0.9.5",
  "loggingId": "TORO",
  "description": "Custom instrument clusters drawn over the whole iDrive 7 cluster: Toro, after the Lamborghini Huracan; M Sport, BMW M's iDrive 8 M View rebuilt from a reference frame; and M Sport Plus, the same dials round the M stripes with a wide picture in the centre. Each style has its own page of settings. Off until you turn it on; BMW's warnings and gear display always stay BMW's.",
  "autostart": true,
  "startType": "autostart",
  "iconGlyph": "gauge",
  "mguHmi": [
    "ID7"
  ],
  "requires": {
    "cluster-render": "0.6.9",
    "mgu-deploy": "0.8.27",
    "mgu-render": "0.6.11"
  },
  "screens": [
    {
      "name": "MAIN",
      "kind": "canvas",
      "title": "mgu-styles2",
      "hmi": false,
      "fill": true,
      "buttons": [
        [
          "BTN_SHOW",
          "Cluster on / off"
        ],
        [
          "BTN_DESIGN",
          "Design"
        ],
        [
          "BTN_CENTRE",
          "Centre picture"
        ],
        [
          "BTN_SETTINGS",
          "Settings"
        ]
      ]
    }
  ],
  "signals": {
    "de.bmw.infotainment.vehicle.Vehicle2": {
      "statusCarSpeed2": "rs"
    },
    "de.bmw.infotainment.vehicle.CDS": {
      "statusEngineSpeed2": "rs",
      "statusEngineTemperature": "rs"
    },
    "de.bmw.infrastructure.VehicleInformation": {
      "statusGearboxDrive": "s",
      "DataPowerTrain2": "s"
    },
    "de.bmw.infrastructure.VehicleCondition": {
      "VehicleCondition": "s",
      "_optional": "the car switching on and off: the theme stays off the cluster then"
    },
    "de.bmw.infotainment.KombiIF": {
      "statusRangeTankStatus": "rs",
      "statusShowTimeDate": "rs",
      "statusBordcomputerAverage": "rs",
      "displayRangeElectricVehicle": "rs",
      "_optional": "Fuel range, tank level and odometer; the time of day the cluster shows; the trip computer's average consumption; electric range"
    },
    "de.bmw.infotainment.drivingexcitement.Efficiencytainment2": {
      "statusChargeOfBatteryHybrid": "rs",
      "statusBatteryTemperature": "rs",
      "_optional": "The drive battery's charge and temperature, on a plug-in hybrid or an electric car"
    },
    "de.bmw.infrastructure.EnvironmentalInformation": {
      "ExteriorTemperature": "s",
      "_optional": "Outside temperature"
    },
    "de.bmw.infotainment.drivingexcitement.FES": {
      "statusSwitchDriveDynamicSport2": "rs",
      "statusFESVehicleDynamicSwitchHMI": "rs",
      "_optional": "Boost pressure from the Sport Display, and the driving mode"
    },
    "de.bmw.infotainment.misc.MDrive": {
      "controlDisplayMSystems": "s",
      "_optional": "Driving mode on M cars"
    },
    "de.bmw.infotainment.vehicle.CDS2": {
      "statusLateralAccelerationMassCenter": "rs",
      "statusLongitudinalAccelerationMassCenter": "rs",
      "_optional": "Lateral and longitudinal load for the G meter"
    },
    "com.harman.infotainment.systemfunctions.tasu.tasu.InternalTasu": {
      "_instances": "SystemFunctionsInternalTasuInst1",
      "_methods": [
        "sendTasuRequest"
      ],
      "_broadcasts": [
        "sendTasuResponse"
      ],
      "_optional": "Oil pressure, intake air temperature and battery voltage read from the engine unit (read only), for cars without BeeM-Flash"
    }
  },
